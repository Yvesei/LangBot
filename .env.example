MISTRAL_API_KEY=
# Pin a supported model version when comparing benchmark runs.
MISTRAL_MODEL=ministral-8b-latest
MISTRAL_TRANSCRIPTION_MODEL=voxtral-small-latest

# Optional: Supabase Auth (Google sign-in). Leave empty to keep the app guest-mode.
# The app runs without these; identity-based rate limiting activates when set.
# Newer Supabase projects name the public key NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY —
# either name works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alternatively set this when your project uses a publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public build-time setting: completed guest chat messages before the sign-in prompt.
NEXT_PUBLIC_GUEST_MESSAGE_LIMIT=5
# Optional server-only key for shared rate limits; requires a separately provisioned RPC.
# Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
