MISTRAL_API_KEY=
# Pin a supported model version when comparing benchmark runs.
MISTRAL_MODEL=ministral-8b-latest
MISTRAL_BILINGUAL_MODEL=voxtral-small-latest
REQUESTS_PER_MINUTE=20
DAILY_REQUEST_LIMIT=1000
# Required for shared limits in production. Local development uses memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Explicit opt-in ONLY for a single-process local production preview.
ALLOW_IN_MEMORY_LIMITS=false
# Optional current model pricing for benchmark cost estimates, USD / million tokens.
EVAL_INPUT_USD_PER_MILLION=
EVAL_OUTPUT_USD_PER_MILLION=
