{
  "name": "languify",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPatterns=tests/unit --runInBand",
    "test:integration": "jest --testPathPatterns=tests/integration --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "typecheck": "tsc --noEmit",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "test:lint": "node --test tests/lint/function-spacing.test.mjs",
    "graphify": "node scripts/graphify.mjs",
    "graphify:setup": "node scripts/graphify.mjs setup",
    "graphify:build": "node scripts/graphify.mjs build",
    "graphify:update": "node scripts/graphify.mjs build",
    "graphify:check": "node scripts/graphify.mjs check-update .",
    "graphify:mcp": "node scripts/graphify.mjs mcp"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.0.1",
    "@fortawesome/react-fontawesome": "^3.0.2",
    "@mistralai/mistralai": "^1.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "dompurify": "^3.2.7",
    "lucide-react": "^0.544.0",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "supertest": "^7.1.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^6.0.3",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "undici": "^7.16.0",
    "vercel": "^48.2.1"
  },
  "lint-staged": {
    "*.{js,jsx,cjs,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "eslint"
    ],
    "!(*.{js,jsx,cjs,mjs,ts,tsx})": "prettier --write --ignore-unknown"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
